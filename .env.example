# Локально ничего задавать не нужно: без DATABASE_URL используется SQLite (app.db).
# Боевая база живёт только на сервере, её настройки лежат там, не в репозитории.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5433/modus
# JWT_SECRET=любая-длинная-строка

# Битрикс24. Секрет хранится только на сервере; не добавляйте VITE_ префикс.
# Режим real/mock/off выбирается администратором в /integrations и хранится в БД.
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/your-secret/
# Адрес Модуса, доступный получателям уведомлений:
MODUS_PUBLIC_URL=https://modus-trade.makquiz.site

# Чат-бот imbot.v2: отдельный случайный секрет длиной 16–40 символов.
# Создать: python -c "import secrets; print(secrets.token_hex(20))"
# BITRIX_BOT_TOKEN=your-random-40-character-token

# 1С: учётная запись только на чтение. Секреты задаются на сервере.
# ONEC_ODATA_URL=https://onec.example.kz/trade/odata/standard.odata
# ONEC_USERNAME=modus_reader
# ONEC_PASSWORD=
# Имена зависят от конфигурации: сверьте с её $metadata.
# ONEC_ENTITY_ITEMS=Catalog_Номенклатура
# ONEC_ENTITY_PARTNERS=Catalog_Контрагенты
# ONEC_ENTITY_PURCHASE=Document_ЗаказПоставщику
# ONEC_ENTITY_SALE=Document_ЗаказКлиента
# ONEC_FIELD_ARTICLE=Артикул
# ONEC_FIELD_PARTNER=Контрагент_Key
# Включает поиск опубликованных документов для всех сотрудников Модуса:
# ONEC_ALLOW_EMPLOYEE_DOCUMENTS=false
